# =============================================================================
# Sinérgica OS — Variáveis de ambiente
# Copie para .env.local e preencha os valores reais.
# NUNCA commite chaves reais. Ver seguranca/baseline-minimo.md.
# =============================================================================

# --- Supabase (Públicas — client) ---
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon_key>
VITE_PORTAL_URL=https://<portal-do-cliente>

# --- Supabase (Servidor — Edge Functions / scripts) ---
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# Evidências de materiais: manter desligadas até migrations, testes e revisão de segurança.
VITE_SSO_EVIDENCIAS_MATERIAIS_ENABLED=false
VITE_SSO_EVIDENCIA_MATERIAL_MEDIADA_ENABLED=false
VITE_SSO_INGESTAO_MATERIAL_MEDIADA_ENABLED=false
VITE_SSO_RECIBO_EVIDENCIA_MATERIAL_ENABLED=false
SSO_EVIDENCIA_MATERIAL_VERIFICADA_ENABLED=false
SSO_EVIDENCIA_MATERIAL_DOWNLOAD_MEDIADO_ENABLED=false

# --- Supabase (CLI local — `supabase link`/`db push` direto, só emergência) ---
SUPABASE_ACCESS_TOKEN=sbp_<personal_access_token>
SUPABASE_PROJECT_ID=<project_ref>
SUPABASE_DB_PASSWORD=<db_password>

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL=https://<sua-instancia-evolution>/
EVOLUTION_API_KEY=<api_key>
EVOLUTION_HMAC_SECRET=<hmac_secret_minimo_32_chars>

# --- Meta Graph API (WhatsApp Cloud, Instagram e Messenger) ---
META_ACCESS_TOKEN=<system_user_access_token>
META_APP_SECRET=<meta_app_secret>
META_GRAPH_VERSION=v22.0

# --- OpenRouter (LLM) ---
OPENROUTER_API_KEY=<openrouter_api_key>
OPENROUTER_ZE_MODEL=google/gemini-2.5-flash
ZE_SYSTEM_USER_ID=<uuid_usuario_sistema_ze>

# --- Auvo (App de campo) ---
AUVO_API_KEY=<auvo_api_key>
AUVO_USER_TOKEN=<auvo_user_token>

# --- Geral ---
CORS_ALLOWED_ORIGINS=https://sinergica.netlify.app
SSO_VARREDURA_OS_ENABLED=false
SSO_VARREDURA_ORIGENS_ENABLED=false
VITE_SSO_APROVACAO_FINALIZACAO_ATOMICA_ENABLED=false
VITE_SSO_CUSTOS_PROPOSTA_ESCOPADOS_ENABLED=true
VITE_SSO_ITENS_CUSTO_PROPOSTA_ENABLED=false
VITE_SSO_HISTORICO_CUSTOS_PROPOSTA_ENABLED=false
VITE_SSO_ITENS_HISTORICOS_CUSTO_ENABLED=false
VITE_SSO_EDITAR_COMPOSICAO_ESCOPADA_ENABLED=false
VITE_SSO_RECIBO_EDICAO_COMPOSICAO_ENABLED=false
VITE_SSO_SISTEMAS_DISTRIBUIDOS_ENABLED=false
VITE_SSO_PLANOS_POR_ALVO_ENABLED=false
VITE_SSO_CONFERENCIA_PLANO_LEGADO_ENABLED=false
VITE_SSO_REFERENCIA_TAREFA_LEGADA_ENABLED=false
VITE_SSO_CONFERENCIA_CANDIDATO_SERVICO_ENABLED=true
VITE_SSO_PUBLICAR_MATERIAIS_MEDIADO_ENABLED=false
VITE_SSO_VISIBILIDADE_MATERIAIS_MEDIADA_ENABLED=false

# S165: habilitar somente após validação, revisão e liberação dos gates no banco.
VITE_SSO_DIAGNOSTICOS_REVISAO_MEDIADOS_ENABLED=false
VITE_SSO_CONTRATO_PERGUNTA_MEDIADO_ENABLED=false
VITE_SSO_PRECONDICAO_IMPACTO_MEDIADA_ENABLED=false
VITE_SSO_FUSO_PLANO_MEDIADO_ENABLED=false

VITE_SSO_DECISOES_IMPACTO_MEDIADAS_ENABLED=false

VITE_SSO_ORIGEM_ROTINA_ENABLED=false

VITE_SSO_CONFERENCIA_FUSO_SERIES_ENABLED=false

VITE_SSO_RESOLUCAO_IMPACTO_ENABLED=false

VITE_SSO_PMOC_MEDIADO_ENABLED=false

VITE_SSO_VINCULO_CICLO_PMOC_ENABLED=false

VITE_SSO_OBRIGACOES_PMOC_ENABLED=false

VITE_SSO_IMPACTO_PMOC_REVISAO_ENABLED=false

VITE_SSO_ORIGEM_EFETIVA_CICLO_ENABLED=false

VITE_SSO_ORIGEM_LOTE_ENABLED=false

VITE_SSO_INVENTARIO_PMOC_REVISAO_ENABLED=false

# Fila de Visitas exige validação e gate de banco; não habilitar isoladamente.
VITE_SSO_FILA_VISITA_ENABLED=false

# S165/S166: opt-in apenas após validação e liberação dos gates correspondentes.
VITE_SSO_TRANSICAO_PLANO_ENABLED=false
VITE_SSO_APROVAR_REVISAO_ENABLED=false
VITE_SSO_PROTOCOLO_REVISAO_1731_ENABLED=false
VITE_SSO_MATERIALIZAR_CICLO_CANONICO_ENABLED=false
VITE_SSO_LOTE_CICLOS_CALENDARIO_ENABLED=false
VITE_SSO_MATERIALIZAR_VISITA_CANONICA_ENABLED=false
VITE_SSO_RECIBO_PREPARACAO_VISITA_ENABLED=false
VITE_SSO_LOTE_VISITA_CANONICA_ENABLED=false
VITE_SSO_FILA_PREVENTIVA_PCM_ENABLED=false

# E01-S195: trechos de deslocamento com enquadramento residencial x operacional; gate de banco
# pcm.sso_trechos_deslocamento_gate fechado por padrão, decisão de manter desligado.
VITE_SSO_TRECHOS_DESLOCAMENTO_ENABLED=false

# E01-S197: pendências técnicas agrupadas por ativo (achado AC-F2 — já usadas em código
# existente de E01-S173/174, nunca declaradas aqui antes desta story).
VITE_SSO_PENDENCIAS_TECNICAS_ENABLED=false
VITE_SSO_PENDENCIAS_FILTRO_ATIVO_ENABLED=false
VITE_SSO_BACKLOG_COMPOSICAO_ENABLED=false

# E01-S199: coluna "Campo a conciliar" no Kanban (fila de entrada das OS que chegaram do Auvo sem
# Chamado). Depende do gate pcm.sso_consulta_estado_campo_gate, fechado por padrão.
VITE_SSO_CAMPO_A_CONCILIAR_ENABLED=false

# E01-S200: matriz de movimentacoes do Kanban. Desligada ate a homologacao confirmar que nenhum
# caminho legitimo de operacao foi travado — ligar so apos observar o quadro em uso real.
VITE_SSO_MATRIZ_TRANSICOES_ENABLED=false

# E01-S201: monitor consolidado das excecoes do Auvo em T-24 (falha de envio, Visita nao
# confirmada, tarefa orfa). Reusa o gate pcm.sso_consulta_estado_campo_gate, fechado por padrao —
# ligar a flag sem abrir o gate so troca a frase na tela, nunca mostra exceção nenhuma.
VITE_SSO_MONITOR_EXCECOES_AUVO_ENABLED=false
# E01-S202: Agenda do Técnico como projeção da Visita, no lugar do cadastro manual (aposentado
# no banco pela migration 1867). Desligada até o gate pcm.capacidade_agenda_tecnico_gate ser
# aberto — com ela desligada a tela é exatamente a de antes.
VITE_SSO_AGENDA_PROJECAO_VISITA_ENABLED=false
# E01-S203: criação manual do Plano PMOC a partir de um Contrato PMOC existente (ADR-1698,
# resposta (b) do cliente em 24/11). Desligada até os gates pcm.sso_pmoc_mediado_gate e
# pcm.sso_diagnostico_pmoc_gate serem abertos — com ela desligada a tela de Planos é a de antes,
# com uma frase explicando que o recurso existe e ainda não foi ativado. PMOC continua no menu.
VITE_SSO_PLANO_PMOC_MANUAL_ENABLED=false

# E01-S190 (BL 013): navegação do SSO agrupada em Trabalho, Gestão e Administração. Desligada
# até a homologação confirmar que nenhuma ação ficou inalcançável — com ela desligada o menu é
# exatamente o anterior (inventário antes/depois idêntico, AC-7).
VITE_SSO_NAVEGACAO_POR_FUNCAO_ENABLED=false

# E01-S190 task 9 (ADR-1697): Assessment deixa o menu e passa a ser a Inspeção do tipo
# "Diagnóstico Inicial do Cliente" — classificação feita pelas migrations 1868/1869. Com ela
# desligada o item "Assessment" continua no menu, exatamente como hoje. Ligada, ele sai e a
# importação do questionário do Auvo passa a ser alcançada de dentro de Inspeções.
VITE_SSO_ASSESSMENT_COMO_INSPECAO_ENABLED=false

# E00-S29 (25/11/2026) — destrave do Financeiro e do Comercial para exploração.
# Espelham o que netlify.toml declara para o build de produção; a migration 1872 abriu as 72
# travas de banco equivalentes. Flag sem trava aberta (ou o contrário) não entrega jornada.
VITE_SSO_ALOCACAO_DOCUMENTO_MEDIADA_ENABLED=true
VITE_SSO_ALOCAR_FATURAVEL_ENABLED=true
VITE_SSO_ANEXOS_FATURAVEIS_ENABLED=true
