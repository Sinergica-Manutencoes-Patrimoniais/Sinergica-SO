# =============================================================================
# Sinérgica OS — Variáveis de ambiente
# Copie para .env.local e preencha os valores reais.
# NUNCA commite chaves reais. Ver seguranca/baseline-minimo.md.
# =============================================================================

# --- Supabase (Públicas — client) ---
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon_key>
VITE_PORTAL_URL=https://<portal-do-cliente>

# --- Supabase (Servidor — Edge Functions / scripts) ---
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# Evidências de materiais: manter desligadas até migrations, testes e revisão de segurança.
VITE_SSO_EVIDENCIAS_MATERIAIS_ENABLED=false
VITE_SSO_EVIDENCIA_MATERIAL_MEDIADA_ENABLED=false
VITE_SSO_INGESTAO_MATERIAL_MEDIADA_ENABLED=false
VITE_SSO_RECIBO_EVIDENCIA_MATERIAL_ENABLED=false
SSO_EVIDENCIA_MATERIAL_VERIFICADA_ENABLED=false
SSO_EVIDENCIA_MATERIAL_DOWNLOAD_MEDIADO_ENABLED=false

# --- Supabase (CLI local — `supabase link`/`db push` direto, só emergência) ---
SUPABASE_ACCESS_TOKEN=sbp_<personal_access_token>
SUPABASE_PROJECT_ID=<project_ref>
SUPABASE_DB_PASSWORD=<db_password>

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL=https://<sua-instancia-evolution>/
EVOLUTION_API_KEY=<api_key>
EVOLUTION_HMAC_SECRET=<hmac_secret_minimo_32_chars>

# --- Meta Graph API (WhatsApp Cloud, Instagram e Messenger) ---
META_ACCESS_TOKEN=<system_user_access_token>
META_APP_SECRET=<meta_app_secret>
META_GRAPH_VERSION=v22.0

# --- OpenRouter (LLM) ---
OPENROUTER_API_KEY=<openrouter_api_key>
OPENROUTER_ZE_MODEL=google/gemini-2.5-flash
ZE_SYSTEM_USER_ID=<uuid_usuario_sistema_ze>

# --- Auvo (App de campo) ---
AUVO_API_KEY=<auvo_api_key>
AUVO_USER_TOKEN=<auvo_user_token>

# --- Geral ---
CORS_ALLOWED_ORIGINS=https://sinergica.netlify.app
SSO_VARREDURA_OS_ENABLED=false
SSO_VARREDURA_ORIGENS_ENABLED=false
VITE_SSO_APROVACAO_FINALIZACAO_ATOMICA_ENABLED=false
VITE_SSO_CUSTOS_PROPOSTA_ESCOPADOS_ENABLED=false
VITE_SSO_ITENS_CUSTO_PROPOSTA_ENABLED=false
VITE_SSO_HISTORICO_CUSTOS_PROPOSTA_ENABLED=false
VITE_SSO_ITENS_HISTORICOS_CUSTO_ENABLED=false
VITE_SSO_EDITAR_COMPOSICAO_ESCOPADA_ENABLED=false
VITE_SSO_RECIBO_EDICAO_COMPOSICAO_ENABLED=false
VITE_SSO_CONFERENCIA_PLANO_LEGADO_ENABLED=false
VITE_SSO_REFERENCIA_TAREFA_LEGADA_ENABLED=false
VITE_SSO_CONFERENCIA_CANDIDATO_SERVICO_ENABLED=false
VITE_SSO_PUBLICAR_MATERIAIS_MEDIADO_ENABLED=false
VITE_SSO_VISIBILIDADE_MATERIAIS_MEDIADA_ENABLED=false

# S165: habilitar somente após validação, revisão e liberação dos gates no banco.
VITE_SSO_DIAGNOSTICOS_REVISAO_MEDIADOS_ENABLED=false
VITE_SSO_CONTRATO_PERGUNTA_MEDIADO_ENABLED=false
VITE_SSO_PRECONDICAO_IMPACTO_MEDIADA_ENABLED=false
VITE_SSO_FUSO_PLANO_MEDIADO_ENABLED=false

VITE_SSO_DECISOES_IMPACTO_MEDIADAS_ENABLED=false

VITE_SSO_ORIGEM_ROTINA_ENABLED=false

VITE_SSO_CONFERENCIA_FUSO_SERIES_ENABLED=false

VITE_SSO_RESOLUCAO_IMPACTO_ENABLED=false

VITE_SSO_PMOC_MEDIADO_ENABLED=false

VITE_SSO_VINCULO_CICLO_PMOC_ENABLED=false

VITE_SSO_OBRIGACOES_PMOC_ENABLED=false

VITE_SSO_IMPACTO_PMOC_REVISAO_ENABLED=false

VITE_SSO_ORIGEM_EFETIVA_CICLO_ENABLED=false

VITE_SSO_ORIGEM_LOTE_ENABLED=false

VITE_SSO_INVENTARIO_PMOC_REVISAO_ENABLED=false

# Fila de Visitas exige validação e gate de banco; não habilitar isoladamente.
VITE_SSO_FILA_VISITA_ENABLED=false
